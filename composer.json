{
	"name": "flarum-lang/georgian",
	"description": "Georgian Language Pack for Flarum",
	"type": "flarum-extension",
	"keywords": [
		"flarum-locale"
	],
	"homepage": "https://github.com/flarum-lang/georgian",
	"license": "MIT",
	"support": {
		"issues": "https://github.com/flarum-lang/georgian/issues",
		"forum": "https://discuss.flarum.org/d/40193",
		"source": "https://github.com/flarum-lang/georgian"
	},
	"require": {
		"flarum/core": "^1.5"
	},
	"extra": {
		"branch-alias": {
			"dev-master": "1.x-dev"
		},
		"flarum-extension": {
			"title": "Georgian",
			"category": "language",
			"icon": {
				"image": "icon.svg",
				"backgroundSize": "cover",
				"backgroundPosition": "center"
			}
		},
		"flarum-locale": {
			"code": "ka",
			"title": "ქართული"
		}
	}
}
